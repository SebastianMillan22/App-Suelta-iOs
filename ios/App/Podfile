require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CodetrixStudioCapacitorGoogleAuth', :path => '../../node_modules/@codetrix-studio/capacitor-google-auth'
  pod 'CordovaPlugins', :path => '../capacitor-cordova-ios-plugins'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # Patch Pods-App-frameworks.sh to inject PrivacyInfo.xcprivacy into third-party frameworks before code signing
  frameworks_script = File.join(installer.sandbox.target_support_files_dir('Pods-App'), 'Pods-App-frameworks.sh')
  if File.exist?(frameworks_script)
    script_content = File.read(frameworks_script)
    marker = "# Injected PrivacyInfo.xcprivacy by Suelta Build"
    unless script_content.include?(marker)
      fn_pattern = /code_sign_if_enabled\s*\(\)\s*\{/
      if script_content =~ fn_pattern
        replacement = <<-SH
code_sign_if_enabled() {
  #{marker}
  if [ -d "$1" ]; then
    local p_manifest="${PODS_ROOT}/../App/PrivacyInfo.xcprivacy"
    if [ -f "${p_manifest}" ]; then
      cp -f "${p_manifest}" "$1/PrivacyInfo.xcprivacy"
      echo "[Podfile Hook] Inyectado PrivacyInfo.xcprivacy en $1"
    fi
  fi
        SH
        updated_content = script_content.sub(fn_pattern, replacement.strip)
        File.write(frameworks_script, updated_content)
        puts "[Podfile] Parcheado exitosamente code_sign_if_enabled en Pods-App-frameworks.sh."
      else
        puts "[Podfile AVISO] No se encontro code_sign_if_enabled en Pods-App-frameworks.sh."
      end
    end
  end

  # Add PrivacyInfo.xcprivacy directly to Pod directories
  privacy_manifest_src = File.expand_path('../../ios/App/App/PrivacyInfo.xcprivacy', __FILE__)
  if File.exist?(privacy_manifest_src)
    ['GoogleSignIn', 'GTMAppAuth', 'GTMSessionFetcher', 'CodetrixStudioCapacitorGoogleAuth'].each do |pod_name|
      pod_dir = File.join(installer.sandbox.root, pod_name)
      if File.exist?(pod_dir)
        dest_path = File.join(pod_dir, 'PrivacyInfo.xcprivacy')
        File.write(dest_path, File.read(privacy_manifest_src))
        puts "[Podfile] Copiado PrivacyInfo.xcprivacy en pod #{pod_name}"
      end
    end
  end
end
